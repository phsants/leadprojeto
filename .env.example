# ---- Banco de dados (PostgreSQL) ----
# No EasyPanel, crie um serviço PostgreSQL e use a connection string interna.
# Exemplo: postgres://usuario:senha@nome-do-servico:5432/qualifica_leads
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qualifica_leads?schema=public"

# ---- Sessão / Autenticação do painel ----
# Gere um valor aleatório forte (mín. 32 caracteres). Ex: openssl rand -base64 48
AUTH_SECRET="troque-este-valor-por-um-segredo-longo-e-aleatorio"

# ---- Seed do primeiro admin (usado apenas em `npm run db:seed`) ----
SEED_ADMIN_EMAIL="admin@clinica.com"
SEED_ADMIN_PASSWORD="MudarEsta@Senha123"
SEED_ADMIN_NAME="Administrador"

# ---- App ----
# URL pública do app (usada em metadata / cookies em produção)
APP_URL="http://localhost:3000"
NODE_ENV="development"
